# Protocole d'origine : celui transmis par un reverse proxy HTTPS en amont, sinon celui de la requête
map $http_x_forwarded_proto $cider_forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    # Derrière un reverse proxy déclaré dans CIDER_REVERSE_PROXY_IPS : $remote_addr devient
    # l'adresse du client (écrit au démarrage par 15-cider-real-ip.sh, vide sinon)
    include /etc/nginx/snippets/real-ip.conf;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json application/wasm image/svg+xml;
    gzip_min_length 1024;
    # compresse aussi quand la requête arrive par un reverse proxy (en-tête Via)
    gzip_proxied any;

    # API : relayée vers le service "api" (comptes et projets).
    # Taille des envois : CIDER_MAX_PROJECT_MB (projets avec images), comme côté serveur.
    location /api/ {
        include /etc/nginx/snippets/security-headers.conf;
        proxy_pass http://api:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # uniquement l'adresse retenue par nginx (celle du client, ou celle annoncée par un
        # reverse proxy de CIDER_REVERSE_PROXY_IPS) : une valeur envoyée par le client lui-même
        # est ignorée (sinon il pourrait contourner la limite de tentatives de connexion)
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $cider_forwarded_proto;
        client_max_body_size ${CIDER_MAX_PROJECT_MB}m;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # index.html jamais mis en cache : les mises à jour sont prises en compte immédiatement
    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
    }

    # Fichiers générés par Angular à la racine (noms avec hash) : cache long
    location ~* ^/[^/]+\.(js|css|woff2?|ttf)$ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Traductions : sans hash dans le nom, revalidées à chaque chargement
    # (sinon une mise à jour affiche des clés brutes comme « binder.page »)
    location /assets/i18n/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    # Bibliothèques livrées sans hash dans le nom (Monaco ~14 Mo, Mermaid, wasm, profils ICC) :
    # gardées un jour par le navigateur, puis revalidées (ETag), au lieu d'un cache à durée devinée
    location ~ ^/assets/(monaco|mermaid|wasm|icc)/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=86400";
        try_files $uri =404;
    }

    # Application monopage : toute route inconnue renvoie vers index.html.
    # Les fichiers de assets/ (Monaco, traductions, wasm) n'ont pas de hash : cache par défaut.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri $uri/ /index.html;
    }
}
