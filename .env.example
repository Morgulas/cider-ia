# Copier ce fichier en .env (ou renseigner ces variables dans Dockhand) puis adapter.

# Port d'accès à l'application sur l'hôte
CIDER_PORT=8080

# Dossier de l'hôte où sont stockés les comptes et les projets
CIDER_DATA_PATH=./data

# Propriétaire des fichiers de données sur l'hôte (résultat de `id -u` et `id -g`)
PUID=1000
PGID=1000

# Durée de vie d'une session inutilisée, en jours
CIDER_SESSION_DAYS=30

# Taille maximale d'un projet (images comprises), en Mo
CIDER_MAX_PROJECT_MB=200

# Nombre maximal de projets par utilisateur
CIDER_MAX_PROJECTS_PER_USER=100

# Code demandé pour créer le premier administrateur.
# Vide : un code aléatoire est affiché dans les logs du conteneur api (docker logs cider-ia-api).
CIDER_SETUP_TOKEN=

# Mettre "true" quand l'application est servie en HTTPS derrière un reverse proxy
CIDER_COOKIE_SECURE=auto
