# Copier ce fichier en .env (ou renseigner ces variables dans Dockhand) puis adapter.

# Version des images (latest, ou sha-<commit> pour figer une version)
CIDER_VERSION=latest

# Port d'accès à l'application sur l'hôte
CIDER_PORT=8080

# Dossier de l'hôte où sont stockés les comptes et les projets
CIDER_DATA_PATH=./data

# Propriétaire des fichiers de données sur l'hôte (résultat de `id -u` et `id -g`)
PUID=1000
PGID=1000

# Durée de vie d'une session inutilisée, en jours
CIDER_SESSION_DAYS=30

# Taille maximale d'un projet (images comprises), en Mo
CIDER_MAX_PROJECT_MB=200

# Nombre maximal de projets par utilisateur
CIDER_MAX_PROJECTS_PER_USER=100

# Code demandé pour créer le premier administrateur.
# Vide : un code aléatoire est affiché dans les logs du conteneur api (docker logs cider-ia-api).
CIDER_SETUP_TOKEN=

# Mettre "true" quand l'application est servie en HTTPS derrière un reverse proxy
CIDER_COOKIE_SECURE=auto

# ---------------------------------------------------------------------------
# IA : génération d'illustrations
# Un service est disponible dès que sa clé (ou son URL pour ComfyUI) est renseignée.
# Les clés restent sur le serveur (conteneur api) et ne sont jamais envoyées au navigateur.
# L'IA est ensuite activée compte par compte dans l'administration, avec un quota mensuel.

# Service proposé par défaut : openai, gemini ou comfyui (vide = le premier configuré)
CIDER_IMAGE_PROVIDER=

# Quota mensuel des nouveaux comptes, en images
CIDER_AI_DEFAULT_MONTHLY_IMAGES=50

# Délai maximal d'une génération, en secondes (moins de 300)
CIDER_AI_TIMEOUT_SECONDS=180

# OpenAI (payant à l'image)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
# low, medium ou high (coût croissant)
OPENAI_IMAGE_QUALITY=medium

# Google Gemini (payant à l'image)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# ComfyUI local (gratuit, nécessite une carte graphique)
COMFYUI_URL=
COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors
COMFYUI_WORKFLOW_FILE=
